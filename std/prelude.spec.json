      "fulfillsRequirements": ["REQ-STD-MATH-002"]
    },
    {
      "name": "pow",
      "kind": "function",
      "signature": "pow(base: Int, exp: Int) -> Int",
      "doc": "Computes base^exp via binary exponentiation.",
      "fulfillsRequirements": ["REQ-STD-MATH-002"]
    },
    {
      "name": "gcd",
      "kind": "function",
      "signature": "gcd(a: Int, b: Int) -> Int",
      "doc": "Computes greatest common divisor using Euclidean algorithm.",
      "fulfillsRequirements": ["REQ-STD-MATH-002"]
    },
    {
      "name": "OptionInt",
      "kind": "type",
      "signature": "type OptionInt = None | Some(Int)",
      "doc": "Optional Int tagged union.",
      "fulfillsRequirements": ["REQ-STD-OPT-001"]
    },
    {
      "name": "unwrap_or",
      "kind": "function",
      "signature": "unwrap_or(opt: OptionInt, default_val: Int) -> Int",
      "doc": "Unwraps Some(v) or returns default_val.",
      "fulfillsRequirements": ["REQ-STD-OPT-001"]
    },
    {
      "name": "sum",
      "kind": "function",
      "signature": "sum(nums: List[Int]) -> Int",
      "doc": "Sums integer list.",
      "fulfillsRequirements": ["REQ-STD-LIST-001"]
    },
    {
      "name": "list_max",
      "kind": "function",
      "signature": "list_max(nums: List[Int], default_val: Int) -> Int",
      "doc": "Finds maximum in list or returns default_val.",
      "fulfillsRequirements": ["REQ-STD-LIST-001"]
    },
    {
      "name": "list_min",
      "kind": "function",
      "signature": "list_min(nums: List[Int], default_val: Int) -> Int",
      "doc": "Finds minimum in list or returns default_val.",
      "fulfillsRequirements": ["REQ-STD-LIST-001"]
    },
    {
      "name": "count_occurrences",
      "kind": "function",
      "signature": "count_occurrences(nums: List[Int], target: Int) -> Int",
      "doc": "Counts occurrences of target in list.",
      "fulfillsRequirements": ["REQ-STD-LIST-001"]
    },
    {
      "name": "list_prefix_sum",
      "kind": "function",
      "signature": "list_prefix_sum(nums: List[Int], count: Int) -> Int",
      "doc": "Sums up to count leading integers. Stops before unselected elements and uses checked Int addition.",
      "fulfillsRequirements": ["REQ-STD-LIST-002"]
    },
    {
      "name": "list_first_or",
      "kind": "function",
      "signature": "list_first_or[T](values: List[T], fallback: T) -> T",
      "doc": "Returns the first element or a fallback of the same type.",
      "fulfillsRequirements": ["REQ-STD-LIST-003"]
    }
  ],
  "tests": [
