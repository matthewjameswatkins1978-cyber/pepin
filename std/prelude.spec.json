{
  "specVersion": 1,
  "module": "std::prelude",
  "sourceFile": "std/prelude.pep",
  "description": "Pepin Core Standard Prelude providing mathematical, logical, Option, and List utilities.",
  "requirements": [
    {
      "id": "REQ-STD-MATH-001",
      "title": "Arithmetic Primitives",
      "description": "Mathematical absolute value, minimum, maximum, clamp, and sign determination.",
      "category": "functional",
      "invariants": [
        "abs(x) >= 0 for all representable x != Int64.min",
        "min(a, b) <= a && min(a, b) <= b",
        "max(a, b) >= a && max(a, b) >= b",
        "lo <= clamp(v, lo, hi) <= hi when lo <= hi"
      ],
      "implementsSymbols": ["abs", "min", "max", "clamp", "sign"],
      "verifiedByTests": ["TEST-STD-MATH-001"]
    },
    {
      "id": "REQ-STD-MATH-002",
      "title": "Exponentiation and GCD",
      "description": "Binary exponentiation and Euclidean greatest common divisor algorithm.",
      "category": "functional",
      "invariants": [
        "pow(b, 0) == 1",
        "pow(b, e) == b * pow(b, e - 1) for e > 0",
        "gcd(a, b) divides both a and b"
      ],
      "implementsSymbols": ["mod", "pow", "gcd", "is_even", "is_odd"],
      "verifiedByTests": ["TEST-STD-MATH-002"]
    },
    {
      "id": "REQ-STD-OPT-001",
      "title": "OptionInt Tagged Union",
      "description": "Safe nullability via tagged union None | Some(Int) with fallback unwrapping.",
      "category": "functional",
      "invariants": [
        "unwrap_or(Some(v), d) == v",
        "unwrap_or(None, d) == d"
      ],
      "implementsSymbols": ["OptionInt", "unwrap_or"],
      "verifiedByTests": ["TEST-STD-OPT-001"]
    },
    {
      "id": "REQ-STD-LIST-001",
      "title": "List Aggregation and Search",
      "description": "List total sum, minimum, maximum, and element frequency counting.",
      "category": "functional",
      "invariants": [
        "sum([]) == 0",
        "list_max([], def) == def",
        "count_occurrences([], target) == 0"
      ],
      "implementsSymbols": ["sum", "list_max", "list_min", "count_occurrences"],
      "verifiedByTests": ["TEST-STD-LIST-001"]
    },
    {
      "id": "REQ-STD-LIST-002",
      "title": "Bounded prefix sum",
      "description": "Sum the first count integers or the entire list if it is shorter. Non-positive counts yield zero.",
      "category": "functional",
      "invariants": [
        "list_prefix_sum([], count) == 0",
        "list_prefix_sum(nums, 0) == 0",
        "list_prefix_sum([1, 2, 3], 2) == 3"
      ],
      "implementsSymbols": ["list_prefix_sum"],
      "verifiedByTests": ["TEST-STD-LIST-002"]
    },
    {
      "id": "REQ-STD-LIST-003",
      "title": "Generic first element with a fallback",
      "description": "Return the first element of a list or the supplied fallback if the list is empty.",
      "category": "functional",
      "invariants": [
        "list_first_or([], fallback) == fallback",
        "list_first_or([1, 2], 3) == 1",
        "The fallback and the list element have the same type."
      ],
      "implementsSymbols": ["list_first_or"],
      "verifiedByTests": ["TEST-STD-LIST-003"]
    }
  ],
  "symbols": [
    {
      "name": "abs",
      "kind": "function",
      "signature": "abs(n: Int) -> Int",
      "doc": "Returns absolute value of n.",
      "fulfillsRequirements": ["REQ-STD-MATH-001"]
    },
    {
      "name": "min",
      "kind": "function",
      "signature": "min(a: Int, b: Int) -> Int",
      "doc": "Returns smaller of two values.",
      "fulfillsRequirements": ["REQ-STD-MATH-001"]
    },
    {
      "name": "max",
      "kind": "function",
      "signature": "max(a: Int, b: Int) -> Int",
      "doc": "Returns larger of two values.",
      "fulfillsRequirements": ["REQ-STD-MATH-001"]
    },
    {
      "name": "clamp",
      "kind": "function",
      "signature": "clamp(v: Int, lo: Int, hi: Int) -> Int",
      "doc": "Clamps value into [lo, hi].",
      "fulfillsRequirements": ["REQ-STD-MATH-001"]
    },
    {
      "name": "sign",
      "kind": "function",
      "signature": "sign(n: Int) -> Int",
      "doc": "Returns -1, 0, or 1.",
      "fulfillsRequirements": ["REQ-STD-MATH-001"]
    },
    {
      "name": "mod",
      "kind": "function",
      "signature": "mod(a: Int, b: Int) -> Int",
      "doc": "Modulo arithmetic.",
      "fulfillsRequirements": ["REQ-STD-MATH-002"]
    },
    {
      "name": "is_even",
      "kind": "function",
