{
  "schemaVersion": 1,
  "runner": "pep test v1 (Road 2 V8 slice 1)",
  "fixtures": [
    {
      "id": "pass/add",
      "file": "fixtures/pass_add.pep",
      "kind": "run",
      "expect": { "exit": 0, "stdout": "42\n" }
    },
    {
      "id": "pass/bool-branches",
      "file": "fixtures/pass_bool.pep",
      "kind": "run",
      "expect": { "exit": 0, "stdout": "1\n0\n" }
    },
    {
      "id": "reject/type-mismatch",
      "file": "fixtures/reject_type_mismatch.pep",
      "kind": "reject",
      "expect": {
        "code": "PEP_TYPE_MISMATCH",
        "span": { "start": { "offset": 26, "line": 1, "column": 27 }, "endOffset": 32 }
      }
    },
    {
      "id": "reject/unknown-function",
      "file": "fixtures/reject_unknown_fn.pep",
      "kind": "reject",
      "expect": {
        "code": "PEP_UNKNOWN_FUNCTION",
        "span": { "start": { "offset": 26, "line": 1, "column": 27 }, "endOffset": 33 }
      }
    },
    {
      "id": "runtime/division-by-zero",
      "file": "fixtures/runtime_div_zero.pep",
      "kind": "run",
      "expect": { "exit": 1, "stdout": "3\n", "diagnosticCode": "PEP_RUNTIME_DIVISION_BY_ZERO" }
    },
    {
      "id": "runtime/int-overflow",
      "file": "fixtures/runtime_int_overflow.pep",
      "kind": "run",
      "expect": { "exit": 1, "stdout": "", "diagnosticCode": "PEP_RUNTIME_OVERFLOW" }
    },
    {
      "id": "check/record-shape",
      "file": "fixtures/check_shapes.pep",
      "kind": "check",
      "expect": {}
    },
    {
      "id": "native/arith-return",
      "file": "fixtures/native_arith_return.pep",
      "kind": "native",
      "expect": { "exit": 0, "stdout": "42\n" }
    },
    {
      "id": "native/call-return",
      "file": "fixtures/native_call_return.pep",
      "kind": "native",
      "expect": { "exit": 0, "stdout": "42\n" }
    },
    {
      "id": "native/if-else",
      "file": "fixtures/native_if_else.pep",
      "kind": "native",
      "expect": { "exit": 0, "stdout": "1\n" }
    },
    {
      "id": "native/negative-subtraction",
      "file": "fixtures/native_negative_sub.pep",
      "kind": "native",
      "expect": { "exit": 0, "stdout": "-14\n" }
    },
    {
      "id": "native/runtime-division-by-zero",
      "file": "fixtures/native_runtime_div_zero.pep",
      "kind": "native",
      "expect": { "match": "diagnostic", "exit": 1,
                  "diagnosticCode": "PEP_RUNTIME_DIVISION_BY_ZERO" }
    },
    {
      "id": "native/runtime-int-overflow",
      "file": "fixtures/native_runtime_overflow.pep",
      "kind": "native",
      "expect": { "match": "diagnostic", "exit": 1,
                  "diagnosticCode": "PEP_RUNTIME_OVERFLOW" }
    },
    {
      "id": "native/reject-type-mismatch",
      "file": "fixtures/native_reject_type_mismatch.pep",
      "kind": "native",
      "expect": { "match": "reject", "diagnosticCode": "PEP_TYPE_MISMATCH" }
    },
    {
      "id": "native/unsupported-unit-main",
      "file": "fixtures/native_unsupported_unit_main.pep",
      "kind": "native",
      "expect": { "exit": 0, "stdout": "hi\n",
                  "nativeUnsupported": "main function must return Int" }
    },
    {
      "id": "native/unsupported-record",
      "file": "fixtures/native_unsupported_record.pep",
      "kind": "native",
      "expect": { "exit": 0, "stdout": "",
                  "nativeUnsupported": "expression lowering does not support this expression" }
    },
    {
      "id": "pass/union-match",
      "file": "fixtures/pass_union_match.pep",
      "kind": "run",
      "expect": { "exit": 0, "stdout": "3\n" }
    },
    {
      "id": "pass/list-loop",
      "file": "fixtures/pass_list_loop.pep",
      "kind": "run",
      "expect": { "exit": 0, "stdout": "42\n" }
    },
    {
      "id": "reject/non-exhaustive-match",
      "file": "fixtures/reject_non_exhaustive.pep",
      "kind": "reject",
      "expect": {
        "code": "PEP_NON_EXHAUSTIVE_MATCH",
        "span": { "start": { "offset": 86, "line": 3, "column": 12 }, "endOffset": 127 }
      }
    },
    {
      "id": "pass/while-loop",
      "file": "fixtures/pass_while_loop.pep",
      "kind": "run",
      "expect": { "exit": 0, "stdout": "0\ndone\n" }
    },
    {
      "id": "reject/field-on-int",
      "file": "fixtures/reject_field_on_int.pep",
      "kind": "reject",
      "expect": {
        "code": "PEP_FIELD_ON_NON_RECORD",
        "span": { "start": { "offset": 29, "line": 1, "column": 30 }, "endOffset": 32 }
      }
    }
  ],
  "limits": { "timeoutSeconds": 120 }
}
